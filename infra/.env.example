# Ambiente de homologacao. Copie para infra/.env e preencha com valores proprios.
# Nenhum valor real e versionado.
POSTGRES_USER=spe
POSTGRES_PASSWORD=
POSTGRES_DB=spe_hml
CORS_ORIGINS=https://localhost
VITE_API_URL=https://localhost/api/v1
JWT_SECRET=
DEVICE_HASH_PEPPER=

# Sessao
JWT_ACCESS_TTL_MIN=15
SESSAO_INATIVIDADE_MIN=30
SESSAO_ABSOLUTA_HORAS=8

# URL publica do painel. O renderizador de PDF abre esta pagina no Chromium do
# container da API, entao o host precisa ser resolvivel de dentro da rede.
PAINEL_URL=https://localhost
# Exportacao
EXPORTACAO_PDF_TIMEOUT_MS=45000
EXPORTACAO_THROTTLE_LIMITE=6
# Certificado autoassinado em homologacao: permite o PDF renderizar o painel.
EXPORTACAO_PDF_TLS_INVALIDO=true

# Backup periodico da base (container proprio, sem cron no host).
BACKUP_INTERVALO_HORAS=6
BACKUP_RETENCAO_DIAS=14

# Verificacao anti-robo (Cloudflare Turnstile). Em producao o obrigatorio e true.
TURNSTILE_SECRET=
TURNSTILE_OBRIGATORIO=false
TURNSTILE_EXIGIR_NO_APLICATIVO=false

# Distribuicao do APK. Preencher ao publicar uma versao nova: ver
# docs/operacao.md, "Publicar a versao".
APP_VERSAO_ATUAL=0.1.0
APP_VERSAO_MINIMA=0.1.0
APP_URL_DOWNLOAD=https://localhost/download.html
APP_URL_APK=
APP_APK_SHA256=
APP_NOTAS_DA_VERSAO=

# Expurgo (LGPD). EXPURGO_ANOS e decisao de conformidade, nao de operacao.
EXPURGO_ANOS=4
EXPURGO_INTERVALO_HORAS=24
EXPURGO_LOTE=1000
EXPURGO_LOTES_POR_CICLO=20

# Ciclo da agregacao que alimenta os graficos do painel, em minutos.
# Volume baixo (poucas respostas por hora) pede ciclo curto: o numero na tela
# fica proximo do real. Para o teste de carga, volte para 10 ou mais.
AGREGACAO_INTERVALO_MIN=10
