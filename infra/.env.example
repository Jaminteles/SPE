# Ambiente de homologacao. Copie para infra/.env e preencha com valores proprios.
# Nenhum valor real e versionado.
POSTGRES_USER=spe
POSTGRES_PASSWORD=
POSTGRES_DB=spe_hml
CORS_ORIGINS=https://localhost
VITE_API_URL=https://localhost/api/v1
JWT_SECRET=
DEVICE_HASH_PEPPER=

# Sessao
JWT_ACCESS_TTL_MIN=15
SESSAO_INATIVIDADE_MIN=30
SESSAO_ABSOLUTA_HORAS=8

# URL publica do painel. O renderizador de PDF abre esta pagina no Chromium do
# container da API, entao o host precisa ser resolvivel de dentro da rede.
PAINEL_URL=https://localhost
# Exportacao
EXPORTACAO_PDF_TIMEOUT_MS=45000
EXPORTACAO_THROTTLE_LIMITE=6
# Certificado autoassinado em homologacao: permite o PDF renderizar o painel.
EXPORTACAO_PDF_TLS_INVALIDO=true
