# Banco de dados
DATABASE_URL="postgresql://spe:spe@localhost:5432/spe_dev?schema=public"

# Aplicação
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173

# Rate limit da rota pública de coleta
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# Segredos (nunca versionar valor real)
JWT_SECRET=troque-em-cada-ambiente
DEVICE_HASH_PEPPER=troque-em-cada-ambiente

# Redis (filas BullMQ)
REDIS_URL=redis://localhost:6379
