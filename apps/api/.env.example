# Banco de dados
DATABASE_URL="postgresql://spe:spe@localhost:5432/spe_dev?schema=public"

# Aplicação
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:5173

# Rate limit da rota pública de coleta
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=60

# Segredos (nunca versionar valor real). JWT_SECRET exige 32+ caracteres.
JWT_SECRET=troque-em-cada-ambiente-com-32-caracteres
DEVICE_HASH_PEPPER=troque-em-cada-ambiente-com-32-caracteres

# Sessao
JWT_ACCESS_TTL_MIN=15
SESSAO_INATIVIDADE_MIN=30
SESSAO_ABSOLUTA_HORAS=8

# TLS: em producao o padrao e exigir HTTPS (proxy repassa X-Forwarded-Proto)
TLS_OBRIGATORIO=false

# Base do link publico de coleta (o QR Code aponta para ela)
COLETA_BASE_URL=http://localhost:5173

# Coleta: limites de origem e sessao de preenchimento
COLETA_THROTTLE_TTL_MS=60000
COLETA_THROTTLE_LIMITE_ABERTURA=30
COLETA_THROTTLE_LIMITE_ENVIO=10
COLETA_SESSAO_MINUTOS=120

# Marcacao automatica de resposta suspeita (limites operacionais, nao segredos)
COLETA_SEGUNDOS_MINIMOS=15
COLETA_SEGUNDOS_POR_PERGUNTA=2
COLETA_JANELA_ORIGEM_MIN=10
COLETA_LIMITE_ORIGEM=15

# Verificacao anti-robo (Cloudflare Turnstile). Sem segredo, fica desligada.
TURNSTILE_SECRET=
TURNSTILE_OBRIGATORIO=false
TURNSTILE_EXIGIR_NO_APLICATIVO=false

# Agregacao pre-calculada (job BullMQ)
AGREGACAO_INTERVALO_MIN=10

# Administrador inicial (usado apenas pelo script npm run criar-admin)
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_SENHA=

# Redis (filas BullMQ)
REDIS_URL=redis://localhost:6379

# --- Exportação ---------------------------------------------------------
# Origem do painel. É a única página que o renderizador de PDF abre.
PAINEL_URL=http://localhost:5173
# Tempo limite de cada tentativa de renderização do PDF.
EXPORTACAO_PDF_TIMEOUT_MS=45000
# Caminho do Chromium quando a imagem já traz um instalado (opcional).
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
# Limite de exportações por origem, por janela.
EXPORTACAO_THROTTLE_TTL_MS=60000
EXPORTACAO_THROTTLE_LIMITE=6
# Aceitar certificado autoassinado ao renderizar o PDF (só homologação).
EXPORTACAO_PDF_TLS_INVALIDO=false
