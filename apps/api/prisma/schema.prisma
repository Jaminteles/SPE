// Fonte de verdade do schema do Sistema de Pesquisa Eleitoral.
// Toda alteracao estrutural nasce aqui e vira migration pelo Prisma.
// Objetos que o Prisma nao modela (indice parcial, CHECK, view materializada)
// sao escritos a mao dentro do migration.sql da migration correspondente.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Acesso
// ---------------------------------------------------------------------------

/// Perfis de acesso ao painel e à administração. O respondente não tem conta.
model Perfil {
  id        String       @id @default(uuid()) @db.Uuid
  codigo    PerfilCodigo @unique
  nome      String       @db.VarChar(60)
  descricao String?      @db.VarChar(240)
  criadoEm  DateTime     @default(now()) @map("criado_em") @db.Timestamptz(6)

  usuarios Usuario[]

  @@map("perfil")
}

enum PerfilCodigo {
  ADMINISTRADOR
  ANALISTA

  @@map("perfil_codigo")
}

model Usuario {
  id            String    @id @default(uuid()) @db.Uuid
  nome          String    @db.VarChar(120)
  email         String    @unique @db.VarChar(180)
  senhaHash     String    @map("senha_hash") @db.VarChar(255)
  ativo         Boolean   @default(true)
  perfilId      String    @map("perfil_id") @db.Uuid
  ultimoLoginEm DateTime? @map("ultimo_login_em") @db.Timestamptz(6)
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm  DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  perfil               Perfil         @relation(fields: [perfilId], references: [id], onDelete: Restrict)
  formulariosCriados   Formulario[]   @relation("FormularioCriadoPor")
  respostasInvalidadas Resposta[]     @relation("RespostaInvalidadaPor")
  logs                 LogAuditoria[]
  sessoes              Sessao[]

  @@index([perfilId])
  @@map("usuario")
}

/// Sessão autenticada. Guarda apenas o hash do refresh token: o valor em claro
/// existe só no cliente. A sessão morre por inatividade, por expiração absoluta
/// ou por encerramento explícito.
model Sessao {
  id                 String        @id @default(uuid()) @db.Uuid
  usuarioId          String        @map("usuario_id") @db.Uuid
  refreshTokenHash   String        @map("refresh_token_hash") @db.Char(64)
  criadaEm           DateTime      @default(now()) @map("criada_em") @db.Timestamptz(6)
  ultimaAtividadeEm  DateTime      @default(now()) @map("ultima_atividade_em") @db.Timestamptz(6)
  expiraEm           DateTime      @map("expira_em") @db.Timestamptz(6)
  encerradaEm        DateTime?     @map("encerrada_em") @db.Timestamptz(6)
  motivoEncerramento SessaoMotivo? @map("motivo_encerramento")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([refreshTokenHash])
  @@index([usuarioId, encerradaEm])
  @@index([ultimaAtividadeEm])
  @@map("sessao")
}

enum SessaoMotivo {
  LOGOUT
  INATIVIDADE
  EXPIRACAO
  SENHA_ALTERADA
  PERMISSAO_ALTERADA
  USUARIO_DESATIVADO

  @@map("sessao_motivo")
}

// ---------------------------------------------------------------------------
// Formulário
// ---------------------------------------------------------------------------

/// Depois que o formulário entra em coleta, perguntas e alternativas são imutáveis.
/// Alteração de conteúdo nasce como novo formulário/versão.
model Formulario {
  id             String           @id @default(uuid()) @db.Uuid
  titulo         String           @db.VarChar(180)
  descricao      String?          @db.VarChar(2000)
  status         FormularioStatus @default(RASCUNHO)
  versao         Int              @default(1)
  vigenciaInicio DateTime?        @map("vigencia_inicio") @db.Timestamptz(6)
  vigenciaFim    DateTime?        @map("vigencia_fim") @db.Timestamptz(6)
  /// Identificador público do link de coleta. Nasce na publicação; nunca é o uuid interno.
  tokenPublico   String?          @unique @map("token_publico") @db.VarChar(32)
  publicadoEm    DateTime?        @map("publicado_em") @db.Timestamptz(6)
  encerradoEm    DateTime?        @map("encerrado_em") @db.Timestamptz(6)
  /// Quando os dados técnicos de duplicidade desta pesquisa foram expurgados.
  expurgoTecnicoEm DateTime?      @map("expurgo_tecnico_em") @db.Timestamptz(6)
  criadoPorId    String?          @map("criado_por_id") @db.Uuid
  criadoEm       DateTime         @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  criadoPor     Usuario?       @relation("FormularioCriadoPor", fields: [criadoPorId], references: [id], onDelete: SetNull)
  perguntas     Pergunta[]
  respostas     Resposta[]
  sessoesColeta SessaoColeta[]

  @@index([status])
  @@index([criadoPorId])
  @@map("formulario")
}

enum FormularioStatus {
  RASCUNHO
  EM_COLETA
  ENCERRADO

  @@map("formulario_status")
}

model Pergunta {
  id           String       @id @default(uuid()) @db.Uuid
  formularioId String       @map("formulario_id") @db.Uuid
  enunciado    String       @db.VarChar(500)
  tipo         PerguntaTipo
  obrigatoria  Boolean      @default(true)
  ordem        Int

  /// Configuração exclusiva do tipo ESCALA. Nos demais tipos fica nula (CHECK na migration).
  escalaMinimo       Int?    @map("escala_minimo")
  escalaMaximo       Int?    @map("escala_maximo")
  escalaRotuloMinimo String? @map("escala_rotulo_minimo") @db.VarChar(60)
  escalaRotuloMaximo String? @map("escala_rotulo_maximo") @db.VarChar(60)

  /// Lógica condicional simples: a pergunta só aparece se esta alternativa tiver sido
  /// escolhida. A pergunta de origem é a dona da alternativa, sempre de ordem anterior.
  /// SetNull é apenas a rede de segurança do banco na exclusão em cascata do formulário —
  /// o serviço recusa excluir alternativa da qual outra pergunta depende.
  condicaoAlternativaId String? @map("condicao_alternativa_id") @db.Uuid

  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  formulario          Formulario     @relation(fields: [formularioId], references: [id], onDelete: Cascade)
  condicaoAlternativa Alternativa?   @relation("AlternativaCondicao", fields: [condicaoAlternativaId], references: [id], onDelete: SetNull)
  alternativas        Alternativa[]
  respostaItens       RespostaItem[]

  @@unique([formularioId, ordem])
  @@index([formularioId])
  @@index([condicaoAlternativaId])
  @@map("pergunta")
}

enum PerguntaTipo {
  UNICA_ESCOLHA
  MULTIPLA_ESCOLHA
  ESCALA
  TEXTO_LIVRE
  NUMERO

  @@map("pergunta_tipo")
}

model Alternativa {
  id         String   @id @default(uuid()) @db.Uuid
  perguntaId String   @map("pergunta_id") @db.Uuid
  texto      String   @db.VarChar(300)
  ordem      Int
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  pergunta               Pergunta       @relation(fields: [perguntaId], references: [id], onDelete: Cascade)
  respostaItens          RespostaItem[]
  perguntasCondicionadas Pergunta[]     @relation("AlternativaCondicao")

  @@unique([perguntaId, ordem])
  @@index([perguntaId])
  @@map("alternativa")
}

// ---------------------------------------------------------------------------
// Município (base oficial do IBGE, restrita à Bahia)
// ---------------------------------------------------------------------------

model Municipio {
  id String @id @default(uuid()) @db.Uuid

  /// Código do município no IBGE. Chave de negócio da apuração.
  codigoIbge   Int      @unique @map("codigo_ibge")
  nome         String   @db.VarChar(120)
  uf           String   @db.Char(2)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  respostas Resposta[]

  @@index([uf, nome])
  @@map("municipio")
}

// ---------------------------------------------------------------------------
// Coleta
// ---------------------------------------------------------------------------

/// Sessão de preenchimento, aberta quando o respondente abre o link.
/// Marca o início real do preenchimento (medido pelo servidor, não declarado
/// pelo aparelho) e é de uso único: o mesmo token não grava duas respostas.
///
/// É dado técnico de duplicidade — expurgado no encerramento da coleta, junto
/// com o hash de dispositivo. Nada aqui identifica o respondente: o hash de
/// origem é HMAC do endereço de rede, guardado só para detectar volume anômalo.
model SessaoColeta {
  id           String    @id @default(uuid()) @db.Uuid
  formularioId String    @map("formulario_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  origemHash   String?   @map("origem_hash") @db.Char(64)
  iniciadaEm   DateTime  @default(now()) @map("iniciada_em") @db.Timestamptz(6)
  expiraEm     DateTime  @map("expira_em") @db.Timestamptz(6)
  usadaEm      DateTime? @map("usada_em") @db.Timestamptz(6)

  formulario Formulario @relation(fields: [formularioId], references: [id], onDelete: Cascade)

  @@index([formularioId, iniciadaEm])
  @@index([origemHash, iniciadaEm])
  @@map("sessao_coleta")
}

// ---------------------------------------------------------------------------
// Resposta
// ---------------------------------------------------------------------------

/// A resposta é anônima por construção: nenhum campo identifica o respondente.
/// O controle de duplicidade usa apenas o hash irreversível do dispositivo.
/// Resposta nunca é excluída: invalidar é mudar o status.
model Resposta {
  id                  String         @id @default(uuid()) @db.Uuid
  formularioId        String         @map("formulario_id") @db.Uuid
  municipioCodigoIbge Int            @map("municipio_codigo_ibge")
  status              RespostaStatus @default(VALIDA)
  origem              RespostaOrigem

  /// Hash irreversível do identificador do dispositivo. Nunca em claro, nunca em log.
  /// Fica nulo depois do expurgo técnico, no encerramento da coleta.
  dispositivoHash String? @map("dispositivo_hash") @db.Char(64)

  /// Momento do aceite do termo de consentimento. Sem aceite não se grava resposta.
  consentimentoEm DateTime @map("consentimento_em") @db.Timestamptz(6)

  /// Geolocalização opcional, só com permissão explícita, usada apenas para conferência.
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  /// Início do preenchimento, medido pelo servidor na abertura da sessão.
  iniciadoEm DateTime @map("iniciado_em") @db.Timestamptz(6)

  coletadoEm DateTime @map("coletado_em") @db.Timestamptz(6)
  recebidoEm DateTime @default(now()) @map("recebido_em") @db.Timestamptz(6)

  /// Tempo de preenchimento em segundos, do início da sessão ao envio.
  duracaoSegundos Int @map("duracao_segundos")

  /// Marcações automáticas que levaram a resposta para conferência.
  marcacoes         RespostaMarcacao[] @map("marcacoes")
  motivoConferencia String?            @map("motivo_conferencia") @db.VarChar(240)
  invalidadaEm      DateTime?          @map("invalidada_em") @db.Timestamptz(6)
  invalidadaPorId   String?            @map("invalidada_por_id") @db.Uuid
  motivoInvalidacao String?            @map("motivo_invalidacao") @db.VarChar(240)

  /// Data a partir da qual a resposta entra na rotina automática de expurgo (4 anos).
  expurgarApos DateTime? @map("expurgar_apos") @db.Timestamptz(6)

  formulario    Formulario     @relation(fields: [formularioId], references: [id], onDelete: Restrict)
  municipio     Municipio      @relation(fields: [municipioCodigoIbge], references: [codigoIbge], onDelete: Restrict)
  invalidadaPor Usuario?       @relation("RespostaInvalidadaPor", fields: [invalidadaPorId], references: [id], onDelete: SetNull)
  itens         RespostaItem[]

  @@index([formularioId, status])
  @@index([formularioId, municipioCodigoIbge, status])
  @@index([recebidoEm])
  @@index([formularioId, duracaoSegundos])
  @@index([marcacoes], map: "ix_resposta_marcacoes", type: Gin)
  @@map("resposta")
}

enum RespostaStatus {
  VALIDA
  EM_CONFERENCIA
  INVALIDADA

  @@map("resposta_status")
}

enum RespostaOrigem {
  APLICATIVO
  WEB

  @@map("resposta_origem")
}

/// Motivos automáticos de suspeita. Marcar não descarta: manda para conferência.
enum RespostaMarcacao {
  TEMPO_MUITO_BAIXO
  PADRAO_REPETITIVO
  VOLUME_ANOMALO_DA_ORIGEM
  MUNICIPIO_FORA_DA_BAHIA

  @@map("resposta_marcacao")
}

/// Item da resposta. Nunca achatar em JSON: a apuração depende do dado estruturado.
model RespostaItem {
  id            String   @id @default(uuid()) @db.Uuid
  respostaId    String   @map("resposta_id") @db.Uuid
  perguntaId    String   @map("pergunta_id") @db.Uuid
  alternativaId String?  @map("alternativa_id") @db.Uuid
  valorTexto    String?  @map("valor_texto") @db.VarChar(1000)
  valorNumero   Decimal? @map("valor_numero") @db.Decimal(18, 4)
  criadoEm      DateTime @default(now()) @map("criado_em") @db.Timestamptz(6)

  resposta    Resposta     @relation(fields: [respostaId], references: [id], onDelete: Cascade)
  pergunta    Pergunta     @relation(fields: [perguntaId], references: [id], onDelete: Restrict)
  alternativa Alternativa? @relation(fields: [alternativaId], references: [id], onDelete: Restrict)

  @@unique([respostaId, perguntaId, alternativaId])
  @@index([perguntaId, alternativaId])
  @@index([respostaId])
  @@map("resposta_item")
}

// ---------------------------------------------------------------------------
// Auditoria
// ---------------------------------------------------------------------------

/// Nunca registrar token, credencial, hash de dispositivo ou qualquer dado
/// que permita reidentificar o respondente.
model LogAuditoria {
  id         String        @id @default(uuid()) @db.Uuid
  usuarioId  String?       @map("usuario_id") @db.Uuid
  acao       AuditoriaAcao
  entidade   String        @db.VarChar(60)
  entidadeId String?       @map("entidade_id") @db.VarChar(64)
  detalhe    Json?
  criadoEm   DateTime      @default(now()) @map("criado_em") @db.Timestamptz(6)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId, criadoEm])
  @@index([acao, criadoEm])
  @@map("log_auditoria")
}

enum AuditoriaAcao {
  LOGIN
  LOGIN_FALHA
  LOGOUT
  SESSAO_EXPIRADA
  USUARIO_CRIADO
  USUARIO_ALTERADO
  USUARIO_DESATIVADO
  SENHA_ALTERADA
  PERMISSAO_ALTERADA
  FORMULARIO_CRIADO
  FORMULARIO_ALTERADO
  FORMULARIO_EXCLUIDO
  FORMULARIO_PUBLICADO
  COLETA_ENCERRADA
  RESPOSTA_INVALIDADA
  RESPOSTA_REVALIDADA
  AGREGACAO_ATUALIZADA
  EXPORTACAO_GERADA
  EXPURGO_TECNICO
  EXPURGO_RESPOSTAS

  @@map("auditoria_acao")
}
