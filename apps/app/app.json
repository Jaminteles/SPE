{
  "expo": {
    "name": "Pesquisa Eleitoral",
    "slug": "spe-coleta",
    "version": "0.1.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "spe",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "br.com.pesquisaeleitoral.coleta",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "8c0aeebd-bd86-42ab-a16e-9289c5729b0c"
      }
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "compileSdkVersion": 35,
            "targetSdkVersion": 34,
            "kotlinVersion": "1.9.25"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "A localização é opcional e serve apenas para conferência da pesquisa. Você pode recusar e responder normalmente."
        }
      ],
      "expo-updates",
      "expo-asset",
      "./plugins/confiar-certificado-do-usuario",
      "./plugins/assinar-release"
    ],
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/8c0aeebd-bd86-42ab-a16e-9289c5729b0c"
    },
    "owner": "jaminteles",
    "ios": {}
  }
}
