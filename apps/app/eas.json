{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },
    "homologacao": {
      "distribution": "internal",
      "channel": "homologacao",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://192.168.1.14/api/v1",
        "SPE_ACEITAR_CA_LOCAL": "1"
      },
      "android": {
        "buildType": "apk"
      },
      "credentialsSource": "local"
    }
  }
}
