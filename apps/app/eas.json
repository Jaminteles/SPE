{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "homologacao": {
      "distribution": "internal",
      "channel": "homologacao",
      "android": {
        "buildType": "apk"
      },
      "credentialsSource": "local"
    },
    "producao": {
      "distribution": "internal",
      "channel": "producao",
      "android": {
        "buildType": "apk"
      },
      "credentialsSource": "local",
      "autoIncrement": "versionCode"
    }
  }
}
