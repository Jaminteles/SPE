{
  "name": "@spe/app",
  "private": true,
  "version": "0.1.0",
  "main": "index.ts",
  "description": "Aplicativo de coleta e administracao do Sistema de Pesquisa Eleitoral",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "build:apk": "eas build --platform android --profile producao",
    "build:apk:hml": "eas build --platform android --profile homologacao"
  },
  "dependencies": {
    "expo": "~52.0.23",
    "expo-build-properties": "~0.13.3",
    "expo-crypto": "~14.0.2",
    "expo-location": "~18.0.10",
    "expo-secure-store": "~14.0.1",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.1",
    "expo-updates": "~0.27.5",
    "react": "18.3.1",
    "react-native": "0.76.5"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "typescript": "~5.3.3"
  }
}
