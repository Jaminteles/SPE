# Lido pelo Vite em `npm run build`. Vale para o painel e para a download.html.
#
# A URL da API não é segredo: ela já vai embutida no APK, que é público e
# inspecionável. Versionar aqui evita depender de alguém lembrar de configurar
# variável no painel da Cloudflare — e trocar de API vira um commit, que já
# dispara o build novo por si só.
#
# Variável de ambiente de verdade continua tendo precedência sobre este arquivo,
# então dá para sobrescrever num build pontual sem editar nada.
VITE_API_URL=https://spe-api.onrender.com/api/v1
